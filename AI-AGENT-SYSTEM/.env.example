# AI Agent System environment variables

# Vector Database (Pinecone)
VECTOR_DB_API_KEY=your_pinecone_api_key
VECTOR_ENV=production
VECTOR_INDEX_NAME=ai-agent-memory

# OpenAI API
OPENAI_API_KEY=your_openai_api_key
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Encryption
ENCRYPTION_KEY=your_32_character_hex_string

# Optional database settings
MONGODB_URI=mongodb://localhost:27017/ai-agent
REDIS_URL=redis://localhost:6379

# Optional JWT secret for API integration
JWT_SECRET=your_jwt_secret
